# MoStar Grid — Environment Configuration
# Copy to .env and fill in your values

# Neo4j
NEO4J_URI=<REDACTED>
NEO4J_USER=<REDACTED>
NEO4J_PASSWORD=<REDACTED>
NEO4J_DATABASE=<REDACTED>
NEO4J_HTTP_URL=<REDACTED>

# Local cluster identity
MOSTAR_CLUSTER_ID=<REDACTED>
MOSTAR_CLUSTER_NAME=<REDACTED>
MOSTAR_CLUSTER_REGION=<REDACTED>

# Ollama
OLLAMA_BASE_URL=<REDACTED>
DCX0_MODEL=<REDACTED>
DCX1_MODEL=<REDACTED>
DCX2_MODEL=<REDACTED>

# Truth Gate Thresholds
TRUTH_IKANG=<REDACTED>
TRUTH_MMONG=<REDACTED>
TRUTH_AFIM=<REDACTED>
TRUTH_ISONG=<REDACTED>

# Woo
WOO_THRESHOLD=<REDACTED>

# Grid API
GRID_HOST=<REDACTED>
GRID_PORT=<REDACTED>
MCP_CLUSTER_API_URL=<REDACTED>

# Sovereign Voice API
PORT=41071
VOICE_ROOT=/home/render/MoStar/voice
PIPER_BIN=/home/render/MoStar/voice/piper/piper
VOICE_MODEL=/home/render/MoStar/voice/models/en_GB-cori-high.onnx
AUDIO_OUT=/home/render/MoStar/voice/audio
VOICE_NAME=mostar-sovereign-v1
GRID_API_URL=https://mostar-grid-api.onrender.com
MOSTAR_SESSION_TOKEN=
MAX_AUDIO_FILES=200
CORS_ORIGINS=*
