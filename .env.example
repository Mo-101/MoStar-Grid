# === MoStar Grid — environment template ===
# Copy to .env locally. Never commit .env. Pre-commit hook will reject it.

# Neo4j substrate
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Ollama / DCX Trinity
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODELS=

# Sovereign port band (41xxx)
PORT_CODE_CONDUIT=41006
PORT_WORKBENCH=41007
PORT_TRUTH_ENGINE=41020
PORT_WOO=41030

# Truth Engine thresholds (elemental)
THRESHOLD_IKANG_FIRE=0.75
THRESHOLD_MMONG_WATER=0.70
THRESHOLD_AFIM_AIR=0.65
THRESHOLD_ISONG_EARTH=0.80

# Woo
WOO_VALIDATION_FLOOR=0.97
WOO_MODE=interpret_only

# Phase 3.6 runtime — DEFAULT FAIL-CLOSED
WOO_RUNTIME_ACTIVATED=false
ENABLE_LIVE_EXECUTION=false
IRON_GATE=closed
