{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MoScript Runtime Receipt",
  "description": "Signed runtime receipt for a governed MoScript execution.",
  "type": "object",
  "required": [
    "schema_version",
    "attestation_id",
    "execution_id",
    "issued_at",
    "runtime_id",
    "binary_hash",
    "program_hash",
    "bytecode_hash",
    "abi_hash",
    "capabilities",
    "decision",
    "receipt_hash",
    "signature",
    "signature_algorithm",
    "key_id"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1, "maximum": 1 },
    "attestation_id": { "type": "string", "format": "uuid" },
    "execution_id": { "type": "string", "format": "uuid" },
    "issued_at": { "type": "string", "format": "date-time" },
    "runtime_id": { "type": "string", "minLength": 1 },
    "binary_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "program_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "bytecode_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "abi_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "capabilities": { "type": "array", "items": { "type": "string" } },
    "decision": { "type": "string", "minLength": 1 },
    "result": { "type": "object" },
    "evidence_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "previous_receipt_hash": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "receipt_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "signature": { "type": "string", "minLength": 1 },
    "signature_algorithm": { "type": "string", "enum": ["Ed25519"] },
    "key_id": { "type": "string", "minLength": 1 }
  }
}
