# ── Keeper Gate environment — /home/idona/.neo4j_keeper_gate.env ──
# Flame fills this. Builder NEVER edits it. chmod 600 after editing.

# Identity of the sacred graph
NEO4J_ENV=production
NEO4J_URI=bolt://127.0.0.1:47687
NEO4J_DATABASE=neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME

# The production bolt port. Destruction against this port is NEVER lawful.
PROD_BOLT_PORT=47687

# Backup vaults
GOLDEN_DIR=/home/idona/neo4j_golden_dumps
DUMP_DIR=/home/idona/neo4j_dumps
DUMP_RETENTION_DAYS=14

# Tripwire: graph below this node count = wound. Writers die.
MIN_NODES=90000

# Truce flag — dump raises it, tripwire respects it
MAINT_FLAG=/tmp/neo4j_maintenance

# Read-only receipt — read-only mode is FORBIDDEN until this file exists
RUNTIME_SPLIT_RECEIPT=/home/idona/runtime_split_migrated.receipt

# Flame's seal — the operator phrase for lawful destruction on NON-prod only.
# Set by Flame's hand. Never committed. Never shared with builder agents.
FLAME_SEAL=CHANGE_ME_FLAME_ONLY

# Keeper ledger — every approach, blocked or permitted, is remembered
KEEPER_LEDGER=/home/idona/keeper_gate_ledger.jsonl
